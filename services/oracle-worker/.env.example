# Oracle Worker Service — environment configuration
# Copy to .env and adjust for your deployment.

# --- Runtime ---
NODE_ENV=production
# Log level: debug | info | warn | error
LOG_LEVEL=info

# --- Oracle worker process ---
# Polling interval (ms) for the oracle resolution loop
ORACLE_POLL_INTERVAL_MS=15000
# Max concurrent resolutions processed per tick
ORACLE_MAX_CONCURRENCY=4
# Graceful shutdown timeout (ms) before the process is force-killed
ORACLE_SHUTDOWN_TIMEOUT_MS=30000

# --- Backend / data dependencies ---
# Base URL of the API used for persistence (no inbound HTTP lifecycle dependency)
API_BASE_URL=http://backend:3000
# Database connection string used directly by the worker
DATABASE_URL=postgres://user:password@db:5432/oracle
# Optional Redis for distributed locking across scaled replicas
REDIS_URL=redis://redis:6379

# --- Chain / oracle provider ---
ORACLE_RPC_URL=https://rpc.example.com
ORACLE_PRIVATE_KEY=
ORACLE_CONTRACT_ADDRESS=

# --- Health check ---
# Port the worker exposes for liveness/readiness probes
HEALTH_PORT=8081
# Interval (ms) between internal health evaluations
HEALTH_CHECK_INTERVAL_MS=10000
