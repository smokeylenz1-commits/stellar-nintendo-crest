.next

# Local environment files — secrets must not enter the build context
.env
.env.*
!.env.example

# Development and editor artifacts
.git
.gitignore
*.md
.vscode
.idea

# Test output
coverage

# OS artefacts
.DS_Store
Thumbs.db
